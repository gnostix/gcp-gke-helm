# cp terraform.tfvars.example terraform.tfvars  (terraform.tfvars is git-ignored)
project_id = "my-gke-lab-project"
region     = "europe-west1"
zone       = "europe-west1-b"
name       = "gke-lab"

# Cost switch: false = no Cloud NAT, nodes get public IPs (cheapest)
enable_nat = false

# NAT for Batch/Nextflow VMs only (GKE stays public). ~$0.12/day.
enable_batch_nat = true

# demo_secret is NOT set here (would be plain text on disk). Use:
#   export TF_VAR_demo_secret="something-secret"
